 _TOKEN_COUNTERS = ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens")
 
 
+def _cost_coverage(status, estimate, actual, api_calls=1) -> str:
+    """Coverage of this report, separate from the legacy last-call cost_status."""
+    def valid(value, *, zero=False):
+        try:
+            amount = float(value)
+        except (TypeError, ValueError, OverflowError):
+            return False
+        return math.isfinite(amount) and (amount >= 0 if zero else amount > 0)
+
+    if status == "included":
+        return "complete" if all(v is None or v == 0 for v in (estimate, actual)) else "unknown"
+    if status in {"estimated", "actual"} and valid(estimate):
+        return "complete"
+    if status == "actual" and valid(actual, zero=True):
+        return "actual_only" if api_calls == 1 else "unknown"
+    return "unknown"
+
+
+def _merge_cost_coverage(previous, report, *, has_history) -> str:
+    if previous == "historical" or (previous is None and has_history):
+        return "historical"
+    if previous == "unknown" or report == "unknown":
+        return "unknown"
+    if has_history and "actual_only" in (previous, report):
+        return "unknown"
+    return report
+
+
+def _ledger_cost(value) -> float:
+    """Invalid dollars stay uncovered, but must not abort the NOT NULL ledger insert."""
+    try:
+        amount = float(value)
+    except (TypeError, ValueError, OverflowError):
+        return 0.0
+    return amount if math.isfinite(amount) and amount >= 0 else 0.0
+
+
