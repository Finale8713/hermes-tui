+def cli_platform_hint() -> str:
+    """Describe the active profile's opt-in code renderer without changing other surfaces."""
+    config = _config_readonly("CLI display capabilities")
+    display = config.get("display", {}) if isinstance(config, dict) else {}
+    if not isinstance(display, dict) or display.get("code_highlighting") is not True:
+        return PLATFORM_HINTS["cli"]
+    return (
+        "You are in the Hermes terminal (CLI). Write prose as plain text. "
+        "For code snippets, use fenced code blocks with a language tag, such as python, bash, "
+        "or makefile. The CLI renders these blocks with syntax colors and hides their outer fences. "
+        "Preserve source indentation and literal tabs. Do not emit terminal escape sequences. "
+        "Terminal selection may expand tabs or include panel borders; for byte-exact source, "
+        "write a file and provide its path. Files: there is no attachment channel and MEDIA:/path "
+        "tags are NOT intercepted here. Deliver a file by stating its absolute path or URL "
+        "in plain text; the user opens it themselves. "
+        f"{_LOCAL_CRON_DELIVERY_NOTE}"
+    )
+
+
