+                "output": _to_decimal(override.get("completion")),
+                "cache_read": _to_decimal(override.get(
+                    "cache_read", override.get("cached_prompt", override.get("input_cache_read")))),
+                "cache_write": _to_decimal(override.get(
+                    "cache_write", override.get("cache_creation", override.get("input_cache_write")))),
+                "request": _to_decimal(override.get("request")),
