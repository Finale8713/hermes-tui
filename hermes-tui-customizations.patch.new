+
+def test_tiny_positive_estimate_qualifies_not_zero(cost_cli, db):
+    record(db, estimate=0.000001)
+    assert cost_cli._get_status_bar_session_cost() == "Session cost ~$<0.0001"
+
+
+def test_tiny_positive_actual_qualifies_not_zero(cost_cli, db):
+    record(db, estimate=None, actual=0.000001, status="actual")
+    assert cost_cli._get_status_bar_session_cost() == "Session cost $<0.0001"
+
+
+def test_positive_estimate_at_precision_keeps_four_decimals(cost_cli, db):
+    record(db, estimate=0.0001)
+    assert cost_cli._get_status_bar_session_cost() == "Session cost ~$0.0001"
+
+
+def test_subprecision_boundary_qualifies(cost_cli, db):
+    # 0.000012 rounds to 0.0000 at 4 dp but is positive money.
+    record(db, estimate=0.000012)
+    assert cost_cli._get_status_bar_session_cost() == "Session cost ~$<0.0001"
+
+
+def test_badge_reads_through_the_gateway_session_store(cost_cli, db, tmp_path):
+    """The rewired CLI's ``_session_db`` is a GatewaySessionStore (the gateway is the single
+    writer). Its ``__getattr__`` allowlist must serve the badge's raw reads
+    (``_session_lineage_root_to_tip`` / ``_read_all`` / ``_is_explicit_fork_child_row``)
+    from the store's read-only WAL reader — otherwise the store returns its ``refused``
+    stub, the badge's except-arm swallows the GatewayClientError, and the badge silently
+    degrades to a permanent "Session cost unavailable"."""
+    from hermes_state import SessionDB as _SessionDB
+    from hermes_cli.gateway_session_store import GatewaySessionStore, SurfaceLabelReader
+
+    record(db)
+    db.flush_token_counts()  # commit so the separate read-only reader sees the rows
+    reader = _SessionDB(db_path=tmp_path / "state.db", read_only=True)
+    store = GatewaySessionStore(connection=SimpleNamespace(final=False))  # __bool__ needs .final
+    store._reader = SurfaceLabelReader(reader)
+    cost_cli._session_db = store
+    cost_cli._status_bar_cost_cache = None
+
+    assert cost_cli._get_status_bar_session_cost() == "Session cost ~$0.1234"
+    # The pre-existing allowlisted read still routes through the reader.
+    assert store.get_session_title("conversation") == "saved title"
diff --git a/tests/hermes_state/test_cost_coverage.py b/tests/hermes_state/test_cost_coverage.py
