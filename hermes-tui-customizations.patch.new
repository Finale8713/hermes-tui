+def test_auxiliary_only_session_uses_auxiliary_ledger(cost_cli, db):
+    db.record_auxiliary_usage("conversation", "vision", model="aux-model",
+                              input_tokens=10, estimated_cost_usd=0.03)
+    assert cost_cli._get_status_bar_session_cost() == "Session cost ~$0.0300"
