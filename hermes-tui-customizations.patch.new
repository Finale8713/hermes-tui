+    assert cost_cli._build_status_bar_text(80).endswith(" Session cost ~$0.1234 ")
+    assert db.get_session_title("conversation") == "saved title"
+    assert cost_cli._pending_title == "saved title"
+    cost_cli._status_bar_field_set_cache = frozenset({"model", "title"})
+    assert "Session cost" not in cost_cli._build_status_bar_text(80)
+    cost_cli._status_bar_field_set_cache = frozenset({"model", "cost"})
+    assert "Session cost ~$0.1234" in cost_cli._build_status_bar_text(80)
