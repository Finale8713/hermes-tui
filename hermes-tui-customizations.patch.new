+def _display_highlighted_resumed_history(cli_instance):
+    """Use the final-content renderer for assistant bodies in the restored recap."""
+    from cli import CLI_CONFIG, _record_output_history_entry, _strip_reasoning_tags, _suspend_output_history
+    from hermes_cli.cli_agent_setup_mixin import _collect_resume_entries, _resume_panel_colors
+    from rich.console import Group
+    from rich.panel import Panel
+    from tools.ansi_strip import sanitize_display_text
+
+    history = getattr(cli_instance, "_resume_display_history", cli_instance.conversation_history)
+    if not history or cli_instance.resume_display == "minimal":
+        return
+    display = CLI_CONFIG.get("display", {})
+    entries, last_index, last_full = _collect_resume_entries(
+        history, display, lambda text: sanitize_display_text(_strip_reasoning_tags(text)))
+    if not entries:
+        return
+    skipped = max(0, len(entries) - int(display.get("resume_exchanges", 10)) * 2)
+    entries = entries[skipped:]
+    if last_index is not None and last_full and 0 <= last_index - skipped < len(entries):
+        entries[last_index - skipped] = ("assistant_last", last_full)
+    body_color, label_color, border_color, assistant_color = _resume_panel_colors()
+    pieces = []
+    if skipped:
+        pieces.append(_RichText(t("cli.resume.earlier_messages", count=skipped), style="dim italic"))
+    for role, text in entries:
+        if role == "event":
+            pieces.append(_RichText("◈ " + text, style="dim italic"))
+        elif role == "user":
+            pieces.append(_RichText(t("cli.resume.label_you") + " " + text, style="dim"))
+        else:
+            pieces.append(_RichText(t("cli.resume.label_assistant", agent_name="Hermes"),
+                                    style=f"bold {assistant_color}"))
+            pieces.append(_render_final_assistant_content(text, cli_instance.final_response_markdown))
+    panel = Panel(Group(*pieces), title=t("cli.resume.panel_title"),
+                  border_style=f"dim {border_color}", padding=(0, 0), style=body_color)
+    _record_output_history_entry(lambda: cli_instance._render_resume_history_panel_lines(panel))
+    with _suspend_output_history():
+        cli_instance._console_print(panel)
+
+
