@@ -259,3 +259,44 @@ def test_every_block_is_framed_by_bars_and_blank_lines(monkeypatch):
                    "", "📖", "💻",                  # tool rows, tight
                    "", "BAR", "☤", "It", "BAR",    # answer
                    "", "─"], got                   # footer
+
+
+def test_top_rule_far_right_slot_honors_the_cost_badge_mode():
+    """``display.status_bar.right_badge: cost`` swaps the top rule's far-right auto title for
+    the session-cost badge, gated by the same ``display.status_bar.fields`` list as the classic
+    bar; title mode keeps upstream's auto-title slot untouched.
+
+    Stubbed cli: importing top-level ``cli`` trips the home-I/O guard on installs whose
+    checkout lives under the real ``~/.hermes`` (hermes_bootstrap reads the sibling
+    ``manifest.json``), so the layout function gets a duck-typed namespace instead.
+    """
+    from types import SimpleNamespace
+    from hermes_cli import cli_modern_layout as layout
+
+    state = {"mode": "cost", "fields": frozenset({"cost"})}
+    cli = SimpleNamespace(
+        _agent_running=False, _command_running=False,
+        _get_tui_terminal_width=lambda: 120,
+        _status_bar_display_width=lambda text: len(text or ""),
+        _trim_status_bar_text=lambda text, max_width: (text or "")[:max(0, max_width)],
+        _get_status_bar_field_set=lambda: state["fields"],
+        _get_status_bar_session_title=lambda: "auto session title",
+        _status_bar_right_badge_mode=lambda: state["mode"],
+        _status_bar_right_badge=lambda snapshot, field_set: "Session cost ~$0.1234"
+        if field_set is None or "cost" in field_set else "",
+    )
+
+    line = "".join(text for _, text in layout.top_rule_fragments(cli))
+    assert "Session cost ~$0.1234" in line, line
+    assert "auto session title" not in line, line
+
+    # Title mode (right_badge unset/title) is upstream behavior: the auto title stays.
+    state["mode"] = "title"
+    line = "".join(text for _, text in layout.top_rule_fragments(cli))
+    assert "auto session title" in line, line
+    assert "Session cost" not in line, line
+
+    # Cost mode with an explicit fields list that omits 'cost' hides the badge entirely.
+    state["mode"], state["fields"] = "cost", frozenset({"model"})
+    line = "".join(text for _, text in layout.top_rule_fragments(cli))
+    assert "Session cost" not in line and "auto session title" not in line, line
diff --git a/tests/hermes_cli/test_cli_status_bar_cost.py b/tests/hermes_cli/test_cli_status_bar_cost.py
new file mode 100644
index 0000000000..2c675865af
--- /dev/null
+++ b/tests/hermes_cli/test_cli_status_bar_cost.py
@@ -0,0 +1,359 @@
+"""Conversation-cost badge behavior against the real session accounting store."""
+from copy import deepcopy
+from datetime import datetime
+from types import SimpleNamespace
+
+import pytest
+import cli as cli_mod
+from cli import HermesCLI
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def cost_cli(monkeypatch):
+    config = deepcopy(cli_mod.CLI_CONFIG)
+    config.setdefault("display", {}).setdefault("status_bar", {})["right_badge"] = "cost"
+    config["display"]["status_bar"].pop("fields", None)
+    monkeypatch.setattr(cli_mod, "CLI_CONFIG", config)
+    obj = HermesCLI.__new__(HermesCLI)
+    obj.model = "test-model"
+    obj.session_id = "conversation"
+    obj.session_start = datetime.now()
+    obj.agent = None
+    obj._status_bar_visible = True
+    obj._pending_title = "saved title"
+    obj._is_session_yolo_active = lambda: False
+    return obj
+
+
+@pytest.fixture
+def db(tmp_path, cost_cli):
+    store = SessionDB(db_path=tmp_path / "state.db")
+    store.create_session("conversation", source="cli", model="model-a")
+    store.set_session_title("conversation", "saved title")
+    cost_cli._session_db = store
+    yield store
+    store.close()
+
+
+def record(db, sid="conversation", model="model-a", estimate=0.1234, actual=None,
+           status="estimated", tokens=100):
+    db.update_token_counts(sid, model=model, billing_provider="openai", input_tokens=tokens,
+                           api_call_count=1, estimated_cost_usd=estimate,
+                           actual_cost_usd=actual, cost_status=status)
+
+
+@pytest.mark.parametrize("width", [8, 23, 24, 30, 35, 51, 52, 75, 76, 80, 120])
+@pytest.mark.parametrize("label", ["Session cost $0.1234", "Session cost ~$0.1234", "Session cost unavailable",
+                                   "Session cost ~$<0.0001", "Session cost $<0.0001"])
+def test_renderers_preserve_complete_cost_and_fit(cost_cli, monkeypatch, width, label):
+    monkeypatch.setattr(cost_cli, "_get_status_bar_session_cost", lambda: label)
+    monkeypatch.setattr(cost_cli, "_get_tui_terminal_width", lambda: width)
+    for text in (cost_cli._build_status_bar_text(width),
+                 "".join(value for _, value in cost_cli._get_status_bar_fragments())):
+        assert cost_cli._status_bar_display_width(text) <= width
+        placed = cost_cli._status_title_badge(label, width, cost=True)
+        if placed:
+            assert text.endswith(f" {label} ")
+            assert cost_cli._status_bar_display_width(text) == width
+        else:
+            assert "Session cost" not in text
+        assert "saved title" not in text
+
+
+def test_default_badge_still_title(cost_cli, monkeypatch):
+    config = deepcopy(cli_mod.CLI_CONFIG)
+    config["display"]["status_bar"].pop("right_badge")
+    monkeypatch.setattr(cli_mod, "CLI_CONFIG", config)
+    assert cost_cli._build_status_bar_text(80).endswith(" saved title ")
+
+
+def test_title_saved_and_cost_field_filter(cost_cli, db):
