 _INCLUDED_NOTE = "subscription-included; no provider invoice for usage"
 
 
+def cost_subprecision_text(amount, decimals: int = 4) -> Optional[str]:
+    """Dollar text for a positive amount that renders as zero at `decimals`
+    precision, e.g. "$<0.0001"; None when the amount renders nonzero.
+
+    Shared by per-response labels and the session-cost badge so a positive
+    total never reads as zero. Uses the render-and-compare trick: a naive
+    numeric threshold misses the exact boundary under ROUND_HALF_EVEN.
+    """
+    if amount <= 0:
+        return None
+    rendered = f"{amount:.{decimals}f}"
+    if float(rendered) != 0.0:
+        return None
+    return f"$<{'0.' + '0' * (decimals - 1) + '1'}"
+
+
 def format_cost_label(amount: Decimal) -> str:
     """Cost display label: zero → "$0.00"; sub-cent → "~$0.0046" (4 dp, or
     "~$<0.0001" when it rounds to 0.0000 so the label never reads as zero);
@@ -47,12 +64,10 @@ def format_cost_label(amount: Decimal) -> str:
     if amount == _ZERO:
         return "$0.00"
     if amount < _SUBCENT_THRESHOLD:
-        label = f"~${amount:.4f}"
-        # Compare the rendered label: a naive `< 0.00005` threshold misses
-        # the exact boundary under ROUND_HALF_EVEN.
-        # A positive amount that rounds to 0.0000 at 4 dp would render "~$0.0000" — a zero-looking label,
-        # the exact #79220 dishonesty.
-        return label if label != "~$0.0000" else "~$<0.0001"
+        qualifier = cost_subprecision_text(amount, 4)
+        if qualifier:
+            return f"~{qualifier}"
+        return f"~${amount:.4f}"
     return f"~${amount:.2f}"
 
