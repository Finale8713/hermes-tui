+"""Cost coverage survives coalescing, resume, and legacy schema reconciliation."""
+import sqlite3
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def db(tmp_path):
+    store = SessionDB(tmp_path / "state.db")
+    store.create_session("s", source="cli", model="m")
+    yield store
+    store.close()
+
+
+def report(estimate, status="estimated", task=""):
+    return dict(model="m", billing_provider="openai", api_call_count=1,
+                input_tokens=10, estimated_cost_usd=estimate, cost_status=status, task=task)
+
+
+@pytest.mark.parametrize("task", ["", "voice_chat"])
+@pytest.mark.parametrize("first,last", [(None, 0.2), (0.2, None), (0, 0.2), (0.2, 0)])
+def test_coalesced_missing_estimate_has_same_coverage_as_sequential(db, tmp_path, task, first, last):
+    batch = [("s", report(estimate, task=task)) for estimate in (first, last)]
+    db._apply_token_batch(batch)
+    with SessionDB(tmp_path / "sequential.db") as sequential:
+        sequential.create_session("s", source="cli", model="m")
+        for sid, kwargs in batch:
+            sequential.update_token_counts(sid, **kwargs)
+        for table in ("sessions", "session_model_usage"):
+            columns = "api_call_count, input_tokens, estimated_cost_usd, cost_status, cost_coverage"
+            actual = dict(db._read_one(f"SELECT {columns} FROM {table}"))
+            expected = dict(sequential._read_one(f"SELECT {columns} FROM {table}"))
+            assert actual == expected
+            assert actual["cost_coverage"] == "unknown"
+            assert actual["api_call_count"] == 2
+
+
+def test_queued_missing_then_known_preserves_gap(db):
+    db.queue_token_counts("s", **report(None, "unknown"))
+    db.queue_token_counts("s", **report(0.2))
+    assert db.flush_token_counts()
+    summary = db.get_session("s")
+    route = dict(db._read_one("SELECT * FROM session_model_usage"))
+    assert summary["cost_status"] == route["cost_status"] == "estimated"
+    assert summary["cost_coverage"] == route["cost_coverage"] == "unknown"
+
+
+def test_complete_included_then_estimated_remains_complete(db):
+    db._apply_token_batch([("s", report(0, "included")), ("s", report(0.2))])
+    for table in ("sessions", "session_model_usage"):
+        row = dict(db._read_one(f"SELECT * FROM {table}"))
+        assert row["cost_coverage"] == "complete"
+        assert row["estimated_cost_usd"] == pytest.approx(0.2)
+
+
+def test_mixed_writer_ownership_is_not_reconciled(db):
+    db.update_token_counts("s", **report(0.2, task="voice_chat"))
+    db.record_auxiliary_usage("s", "voice_chat", model="m", billing_provider="openai",
+                              input_tokens=10, estimated_cost_usd=0.3)
+    row = dict(db._read_one("SELECT * FROM session_model_usage"))
+    assert row["summary_included"] is None
+    assert row["estimated_cost_usd"] == pytest.approx(0.5)
+    assert db.get_session("s")["estimated_cost_usd"] == pytest.approx(0.2)
+
+
+def test_new_columns_leave_legacy_coverage_unproven(tmp_path):
+    path = tmp_path / "legacy.db"
+    with SessionDB(path) as store:
+        store.create_session("s", source="cli")
+        store.update_token_counts("s", **report(0.2))
+    with sqlite3.connect(path) as conn:
+        conn.execute("ALTER TABLE sessions DROP COLUMN cost_coverage")
+        conn.execute("ALTER TABLE session_model_usage DROP COLUMN cost_coverage")
+        conn.execute("ALTER TABLE session_model_usage DROP COLUMN summary_included")
+    with SessionDB(path) as store:
+        assert store.get_session("s")["cost_coverage"] is None
+        route = dict(store._read_one("SELECT * FROM session_model_usage"))
+        assert route["cost_coverage"] is None
+        assert route["summary_included"] is None
+        store.update_token_counts("s", **report(0.3))
+        assert store.get_session("s")["cost_coverage"] == "historical"
+        route = dict(store._read_one("SELECT * FROM session_model_usage"))
+        assert route["cost_coverage"] == "historical"
+        assert route["summary_included"] is None
+
+
+def legacy_usage_pk(conn):
+    """Regress only the key, leaving current usage rows and metadata intact."""
+    conn.execute("PRAGMA foreign_keys=OFF")
+    conn.execute("ALTER TABLE session_model_usage RENAME TO old_usage")
+    ddl = conn.execute("SELECT sql FROM sqlite_master WHERE name='old_usage'").fetchone()[0]
+    ddl = ddl.replace('"old_usage"', "session_model_usage")
+    ddl = ddl.replace("billing_mode, task)", "billing_mode)")
+    conn.execute(ddl)
+    conn.execute("INSERT INTO session_model_usage SELECT * FROM old_usage")
+    conn.execute("DROP TABLE old_usage")
+    conn.execute("PRAGMA foreign_keys=ON")
+
+
+@pytest.mark.parametrize("reopen", [False, True])
+@pytest.mark.parametrize("coverage,ownership", [("complete", 1), ("unknown", 0),
+                                               ("historical", None), (None, None)])
+def test_pk_heal_preserves_existing_coverage_and_ownership(tmp_path, reopen, coverage, ownership):
+    path = tmp_path / "legacy-pk.db"
+    with SessionDB(path) as store:
+        store.create_session("s", source="cli")
+        store.update_token_counts("s", **report(0.2))
+        store._conn.execute("UPDATE session_model_usage SET cost_coverage=?, summary_included=?",
+                            (coverage, ownership))
+        legacy_usage_pk(store._conn)
+        if not reopen:
+            store._heal_session_model_usage_pk(store._conn.cursor())
+            row = dict(store._read_one("SELECT task, cost_coverage, summary_included, estimated_cost_usd "
+                                       "FROM session_model_usage"))
+            assert row == dict(task="", cost_coverage=coverage, summary_included=ownership,
+                               estimated_cost_usd=0.2)
+    with SessionDB(path) as store:
+        row = dict(store._read_one("SELECT task, cost_coverage, summary_included, estimated_cost_usd "
+                                   "FROM session_model_usage"))
+        assert row == dict(task="", cost_coverage=coverage, summary_included=ownership,
+                           estimated_cost_usd=0.2)
+        assert [r[1] for r in store._conn.execute("PRAGMA table_info(session_model_usage)") if r[5]][-1] == "task"
+
+
+@pytest.mark.parametrize("reopen", [False, True])
+@pytest.mark.parametrize("missing", [("cost_coverage",), ("summary_included",),
+                                     ("cost_coverage", "summary_included")])
+def test_pk_heal_missing_metadata_remains_null(tmp_path, reopen, missing):
+    path = tmp_path / "old-metadata.db"
+    with SessionDB(path) as store:
+        store.create_session("s", source="cli")
+        store.update_token_counts("s", **report(0.2))
+        legacy_usage_pk(store._conn)
+        for column in missing:
+            store._conn.execute(f"ALTER TABLE session_model_usage DROP COLUMN {column}")
+        if not reopen:
+            store._heal_session_model_usage_pk(store._conn.cursor())
+            row = dict(store._read_one("SELECT cost_coverage, summary_included FROM session_model_usage"))
+            assert row == dict(cost_coverage=None if "cost_coverage" in missing else "complete",
+                               summary_included=None if "summary_included" in missing else 1)
+    with SessionDB(path) as store:
+        row = dict(store._read_one("SELECT cost_coverage, summary_included FROM session_model_usage"))
+        assert row == dict(cost_coverage=None if "cost_coverage" in missing else "complete",
+                           summary_included=None if "summary_included" in missing else 1)
+        assert store._read_one("SELECT estimated_cost_usd FROM session_model_usage")[0] == 0.2
+
+
+def test_pk_heal_keeps_status_bar_cost_readable(tmp_path):
+    import cli
+
+    path = tmp_path / "status-bar-pk.db"
+    with SessionDB(path) as store:
+        store.create_session("s", source="cli")
+        store.update_token_counts("s", **report(0.2))
+        legacy_usage_pk(store._conn)
+        obj = cli.HermesCLI.__new__(cli.HermesCLI)
+        obj._session_db = store
+        obj.agent = None
+        obj.session_id = "s"
+        assert obj._get_status_bar_session_cost() == "Session cost ~$0.2000"
+        store._heal_session_model_usage_pk(store._conn.cursor())
+        obj._status_bar_cost_cache = None
+        assert obj._get_status_bar_session_cost() == "Session cost ~$0.2000"
+    with SessionDB(path) as store:
+        obj._session_db = store
+        obj._status_bar_cost_cache = None
+        assert obj._get_status_bar_session_cost() == "Session cost ~$0.2000"
+
+
+def test_absolute_multicall_status_does_not_prove_coverage(db):
+    db.update_token_counts("s", **{**report(0.2), "api_call_count": 2, "absolute": True})
+    assert db.get_session("s")["cost_coverage"] == "historical"
+
+
+def test_coalesced_actual_only_calls_are_not_complete_estimate(db, tmp_path):
+    batch = [("s", {**report(None, "actual"), "actual_cost_usd": 0.1}) for _ in range(2)]
+    db._apply_token_batch(batch)
+    with SessionDB(tmp_path / "sequential.db") as sequential:
+        sequential.create_session("s", source="cli", model="m")
+        for sid, kwargs in batch:
+            sequential.update_token_counts(sid, **kwargs)
+        for table in ("sessions", "session_model_usage"):
+            assert db._read_one(f"SELECT cost_coverage FROM {table}")[0] == "unknown"
+            assert sequential._read_one(f"SELECT cost_coverage FROM {table}")[0] == "unknown"
