+def test_snapshot_fallback_keeps_vim_when_space_permits(cost_cli, monkeypatch):
+    cost_cli.model = "long-model-" * 20
+    cost_cli.agent = SimpleNamespace(session_api_calls="bad", session_cost_status="estimated",
+                                    context_compressor=SimpleNamespace(last_prompt_tokens="bad"))
+    monkeypatch.setattr(cost_cli, "_vim_mode_label", lambda: "NORMAL")
+    monkeypatch.setattr(cost_cli, "_get_tui_terminal_width", lambda: 80)
+    text = "".join(value for _, value in cost_cli._get_status_bar_fragments())
+    assert "NORMAL" in text
+    assert text.endswith(" Session cost unavailable ")
+    assert cost_cli._status_bar_display_width(text) == 80
