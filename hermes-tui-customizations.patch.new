diff --git a/tests/hermes_cli/test_cli_code_blocks.py b/tests/hermes_cli/test_cli_code_blocks.py
new file mode 100644
index 0000000000..4ca8251e40
--- /dev/null
+++ b/tests/hermes_cli/test_cli_code_blocks.py
@@ -0,0 +1,500 @@
+"""Behavior tests runnable without pytest: python -m unittest discover ..."""
+from io import StringIO
+import re
+import unittest
+from unittest.mock import patch
+
+import cli
+from rich.console import Console
+from rich.panel import Panel
+from rich.text import Text
+from hermes_cli.cli_code_blocks import CodeBlock, code_block_ansi, render_code_block, split_fenced_code
+
+
+def plain_ansi(value):
+    return re.sub(r"\x1b\[[0-9;]*m", "", value)
+
+
+class CodeBlockTests(unittest.TestCase):
+    def setUp(self):
+        self.config = patch.dict(cli.CLI_CONFIG, {"display": {"code_highlighting": True}})
+        self.config.start()
+        self.addCleanup(self.config.stop)
+
+    def stream(self, text, chunk_size=1, finish=True, enabled=True):
+        obj = cli.HermesCLI.__new__(cli.HermesCLI)
+        obj.code_highlighting = enabled
+        obj.final_response_markdown = "strip"
+        obj.show_reasoning = False
+        obj.show_timestamps = False
+        obj._reset_stream_state()
+        obj._scrollback_box_width = lambda: 40
+        output = []
+        with patch.object(cli, "_cprint", lambda value: output.append(str(value))):
+            for start in range(0, len(text), chunk_size):
+                obj._stream_delta(text[start:start + chunk_size])
+            if finish:
+                obj._flush_stream()
+        return obj, "\n".join(output), output
+
+    def final(self, text, mode="strip", width=80):
+        renderable = cli._render_final_assistant_content(text, mode)
+        buf = StringIO()
+        Console(file=buf, force_terminal=True, color_system="truecolor", width=width).print(renderable)
+        return buf.getvalue()
+
+    def test_stream_and_final_preserve_source_and_colors(self):
+        source = 'def hello():\n    print("**raw**", "[x](url)")\n'
+        response = "# Heading\n```python\n" + source + "```\n**Done**"
+        for output in (self.stream(response)[1], self.final(response)):
+            plain = Text.from_ansi(output).plain
+            self.assertIn("Heading\npython\n" + source + "Done", plain)
+            self.assertNotIn("```", plain)
+            self.assertNotIn("# Heading", plain)
+            self.assertIn("48;2;32;36;44", output)
+            self.assertIn("38;2;", output)
+        code_ansi = code_block_ansi(CodeBlock(source, "python"))
+        self.assertIn("38;2;102;217;239", code_ansi)  # monokai keyword
+        self.assertEqual(plain_ansi(code_ansi), "python\n" + source)
+
+    def test_code_not_table_or_markdown(self):
+        source = "# comment\n| a | b |\n| --- | --- |\n**bold** _value_ `x`\n"
+        for output in (self.stream("~~~text\n" + source + "~~~")[1],
+                       self.final("~~~text\n" + source + "~~~")):
+            self.assertIn("text\n" + source, Text.from_ansi(output).plain)
+
+    def test_literal_think_tags_survive_all_chunk_sizes(self):
+        text = "<think>hidden</think>\n```xml\n<think>literal</think>\n<tool_call>x</tool_call>\n```\nVisible"
+        for chunk in (1, 2, 7, len(text)):
+            output = Text.from_ansi(self.stream(text, chunk)[1]).plain
+            self.assertIn("xml\n<think>literal</think>\n<tool_call>x</tool_call>\nVisible", output)
+            self.assertNotIn("hidden", output)
+
+    def test_final_scrubbing_preserves_fenced_tags_and_raw_history(self):
+        source = "<think>hidden</think>\n```xml\n<think>literal</think>\n```"
+        cleaned = cli._assistant_copy_text(source)
+        self.assertEqual(cleaned, "```xml\n<think>literal</think>\n```")
+        self.assertIn("xml\n<think>literal</think>", Text.from_ansi(self.final(cleaned)).plain)
+        self.assertEqual(source, "<think>hidden</think>\n```xml\n<think>literal</think>\n```")
+
+    def test_unknown_and_unlabelled(self):
+        for language, label in (("not-a-real-language", "not-a-real-language"), ("", "text")):
+            text = "```" + language + "\n  raw **x**\n```"
+            for output in (self.stream(text)[1], self.final(text)):
+                self.assertIn(label + "\n  raw **x**\n", Text.from_ansi(output).plain)
+                self.assertIn("48;2;32;36;44", output)
+
+    def test_fence_lengths_and_characters(self):
+        cases = (("````python", "```\n~~~\n", "`````"),
+                 ("~~~~text", "~~~\n```\n", "~~~~"))
+        for opening, source, closing in cases:
+            response = opening + "\n" + source + closing + "\nDone"
+            for output in (self.stream(response)[1], self.final(response)):
+                self.assertIn(source + "Done", Text.from_ansi(output).plain)
+
+    def test_inline_fences_and_invalid_openers_are_prose(self):
+        text = "mention ```python here\n    ```python\n```bad`info\n"
+        self.assertEqual(list(split_fenced_code(text)), [text])
+
+    def test_incomplete_and_partial_close(self):
+        for text, expected in (("```python\n    print(1)", "python\n    print(1)\n"),
+                               ("```xml\n<think", "xml\n<think\n"),
+                               ("```text\nraw\n``", "text\nraw\n``\n"),
+                               ("```python", "python\n")):
+            for output in (self.stream(text)[1], self.final(text)):
+                self.assertIn(expected, Text.from_ansi(output).plain)
+
+    def test_boundary_flush_and_reset(self):
+        obj, _, output = self.stream("```python\n    print(1)", finish=False)
+        with patch.object(cli, "_cprint", lambda value: output.append(str(value))):
+            obj._stream_delta(None)
+            obj._stream_delta("**Next**\n")
+            obj._flush_stream()
+        plain = Text.from_ansi("\n".join(output)).plain
+        self.assertIn("python\n    print(1)\n", plain)
+        self.assertIn("Next\n", plain)
+        self.assertEqual(plain.count("python"), 1)
+        self.assertNotIn("**Next**", plain)
+
+    def test_block_is_buffered_until_close_not_duplicated(self):
+        obj, _, output = self.stream("```python\ndef hello():\n", finish=False)
+        self.assertNotIn("def hello", Text.from_ansi("\n".join(output)).plain)
+        with patch.object(cli, "_cprint", lambda value: output.append(str(value))):
+            obj._stream_delta("    return 1\n```\n")
+            obj._flush_stream()
+            obj._flush_stream()
+        plain = Text.from_ansi("\n".join(output)).plain
+        self.assertEqual(plain.count("def hello():"), 1)
+        self.assertIn("    return 1", plain)
+
+    def test_narrow_stream_does_not_truncate_or_insert_newlines(self):
+        source = "    print('" + "x" * 100 + "')\n"
+        with patch.object(cli, "_terminal_columns", lambda: 8):
+            output = self.stream("```python\n" + source + "```")[1]
+        self.assertIn("python\n" + source, Text.from_ansi(output).plain)
+        # Rich final rendering in a narrow panel must retain every character too.
+        buf = StringIO()
+        Console(file=buf, width=12, color_system=None).print(
+            Panel(cli._render_final_assistant_content("```text\n" + source + "```", "strip")))
+        self.assertEqual(buf.getvalue().count("x"), 101)  # includes the text language label
+
+    def test_multiline_lexer_state(self):
+        source = 'value = """first\nsecond\n"""\n'
+        ansi = code_block_ansi(CodeBlock(source, "python"))
+        self.assertEqual(plain_ansi(ansi), "python\n" + source)
+        second = ansi.splitlines()[2]
+        self.assertIn("38;2;230;219;116", second)  # multiline string color
+
+    def test_empty_blocks(self):
+        for output in (self.stream("~~~\n~~~\n")[1], self.final("~~~\n~~~\n")):
+            self.assertIn("text\n", Text.from_ansi(output).plain)
+
+    def test_raw_and_render_modes_share_code_renderer(self):
+        for mode in ("raw", "render"):
+            plain = Text.from_ansi(self.final("```python\n  print(1)\n```", mode)).plain
+            self.assertIn("python", plain)
+            self.assertIn("  print(1)", plain)
+            self.assertNotIn("```", plain)
+
+    def test_disabled_default_keeps_old_output(self):
+        with patch.dict(cli.CLI_CONFIG, {"display": {}}):
+            self.assertEqual(cli._render_final_assistant_content("**x**\n```python\n1\n```", "strip").plain,
+                             "x\npython\n1")
+        output = Text.from_ansi(self.stream("**x**\n```python\n1\n```", enabled=False)[1]).plain
+        self.assertIn("x\npython\n1", output)
+
+    def test_real_init_reads_boolean_option(self):
+        obj = cli.HermesCLI.__new__(cli.HermesCLI)
+        for display, enabled in (({}, False), ({"code_highlighting": True}, True),
+                                 ({"code_highlighting": False}, False), ({"code_highlighting": "false"}, False)):
+            with patch.dict(cli.CLI_CONFIG, {"display": display}):
+                obj._init_display_options(None, None)
+            self.assertEqual(obj.code_highlighting, enabled)
+
+    def test_actual_restored_history_uses_shared_renderer_and_preserves_storage(self):
+        obj = cli.HermesCLI.__new__(cli.HermesCLI)
+        obj.code_highlighting = True
+        obj.final_response_markdown = "strip"
+        obj.resume_display = "full"
+        source = "# Restored\n```python\n    print('**raw**')\n```"
+        obj.conversation_history = [{"role": "user", "content": "show code"},
+                                    {"role": "assistant", "content": source}]
+        buf = StringIO()
+        console = Console(file=buf, width=80, force_terminal=True, color_system="truecolor")
+        obj._console_print = console.print
+        obj._display_resumed_history()
+        output = buf.getvalue()
+        plain = Text.from_ansi(output).plain
+        self.assertIn("Restored", plain)
+        self.assertIn("    print('**raw**')", plain)
+        self.assertNotIn("```", plain)
+        self.assertNotIn("# Restored", plain)
+        self.assertIn("48;2;32;36;44", output)
+        self.assertEqual(obj.conversation_history[1]["content"], source)
+
+    def test_prose_with_no_fences_is_unchanged(self):
+        source = "# Heading\n\n**bold** and `literal`\n- item\n  - nested\n"
+        for source in (source, "    unfenced(1)  \n"):
+            for mode in ("strip", "raw", "render"):
+                enabled = self.final(source, mode)
+                with patch.dict(cli.CLI_CONFIG, {"display": {}}):
+                    disabled = self.final(source, mode)
+                self.assertEqual(plain_ansi(enabled), plain_ansi(disabled))
+
+    def test_table_adjacent_to_code_does_not_capture_code(self):
+        source = "| x | y |\n| --- | --- |\n| 1 | 2 |\n```text\n| raw | table |\n```\nDone"
+        output = plain_ansi(self.stream(source)[1])
+        self.assertIn("text\n| raw | table |\nDone", output)
+        self.assertLess(output.index("| 1"), output.index("text\n"))
+
+    def test_partial_literal_tag_at_end_of_prose_is_not_lost(self):
+        output = plain_ansi(self.stream("literal <thi")[1])
+        self.assertIn("literal <thi", output)
+
+    def test_existing_markdown_regressions(self):
+        import importlib.util
+        from pathlib import Path
+        spec = importlib.util.spec_from_file_location(
+            "markdown_regressions", Path(__file__).with_name("test_cli_markdown_rendering.py"))
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        with patch.dict(cli.CLI_CONFIG, {"display": {}}):
+            for name, test in vars(module).items():
+                if name.startswith("test_"):
+                    with self.subTest(name=name):
+                        test()
+
+    def resumed(self, source, mode="strip"):
+        obj = cli.HermesCLI.__new__(cli.HermesCLI)
+        obj.code_highlighting = True
+        obj.final_response_markdown = mode
+        obj.resume_display = "full"
+        obj.conversation_history = [{"role": "assistant", "content": source}]
+        buf = StringIO()
+        obj._console_print = Console(file=buf, width=100, force_terminal=True,
+                                     color_system="truecolor").print
+        obj._display_resumed_history()
+        self.assertEqual(obj.conversation_history[0]["content"], source)
+        return buf.getvalue()
+
+    def test_reasoning_fences_hidden_in_stream_final_copy_and_resume(self):
+        for fence in ("```", "~~~"):
+            for ending in ("private tail</think>\nVisible", "private tail"):
+                source = "<think>\n" + fence + "python\nSECRET = 123\n" + fence + "\n" + ending
+                expected = "Visible" if "</think>" in ending else ""
+                self.assertEqual(cli._assistant_copy_text(source), expected)
+                outputs = [self.final(source, mode) for mode in ("strip", "raw", "render")]
+                outputs.append(self.resumed(source))
+                outputs.extend(self.stream(source, chunk)[1] for chunk in (1, 2, 7, len(source)))
+                for output in outputs:
+                    with self.subTest(fence=fence, ending=ending, output=repr(output)):
+                        plain = plain_ansi(output)
+                        self.assertNotIn("SECRET", plain)
+                        self.assertNotIn("private tail", plain)
+                        if expected:
+                            self.assertIn(expected, plain)
+
+    def test_reasoning_close_immediately_before_fence(self):
+        source = "<think>hidden\n</think>```xml\n<think>literal</think>\n```\nDone"
+        self.assertEqual(cli._assistant_copy_text(source),
+                         "```xml\n<think>literal</think>\n```\nDone")
+        outputs = [self.final(source, mode) for mode in ("strip", "raw", "render")]
+        outputs.extend(self.stream(source, chunk)[1] for chunk in (1, 2, 7, len(source)))
+        outputs.append(self.resumed(source))
+        for output in outputs:
+            self.assertIn("<think>literal</think>", plain_ansi(output))
+            self.assertIn("Done", plain_ansi(output))
+            self.assertNotIn("hidden", plain_ansi(output))
+
+    def test_nested_reasoning_stays_hidden_in_final_copy_and_resume(self):
+        sources = (
+            "<think>outer\n<reasoning>inner</reasoning>SECRET</think>\nDone",
+            "<think>outer<think>inner</think>SECRET</think>\nDone",
+            "<THINK>outer<Reasoning>inner</rEaSoNiNg>SECRET</think>\nDone",
+            "<think>outer</reasoning>SECRET</think>\nDone",
+            "<think>outer<reasoning>inner</think>SECRET</reasoning></think>\nDone",
+        )
+        for source in sources:
+            with self.subTest(source=source):
+                self.assertEqual(cli._assistant_copy_text(source), "Done")
+                for mode in ("strip", "raw", "render"):
+                    for output in (self.final(source, mode), self.resumed(source, mode)):
+                        plain = plain_ansi(output)
+                        self.assertNotIn("SECRET", plain)
+                        self.assertNotIn("outer", plain)
+                        self.assertNotIn("inner", plain)
+                        self.assertIn("Done", plain)
+        for source in ("<think>outer<reasoning>inner</reasoning>SECRET",
+                       "<think>outer</reasoning>SECRET"):
+            self.assertEqual(cli._assistant_copy_text(source), "")
+            self.assertNotIn("SECRET", plain_ansi(self.final(source)))
+            self.assertNotIn("SECRET", plain_ansi(self.resumed(source)))
+
+    def test_literal_reasoning_tag_in_visible_fence_info(self):
+        for fence in ("```", "~~~"):
+            for prefix in ("", "<think>hidden\n</think>"):
+                source = prefix + fence + "xml <think>\n<think>literal</think>\n" + fence + "\nDone"
+                expected = fence + "xml <think>\n<think>literal</think>\n" + fence + "\nDone"
+                self.assertEqual(cli._assistant_copy_text(source), expected)
+                outputs = [self.final(source, mode) for mode in ("strip", "raw", "render")]
+                outputs.append(self.resumed(source))
+                outputs.extend(self.stream(source, chunk)[1] for chunk in (1, 2, 7, len(source)))
+                for output in outputs:
+                    plain = plain_ansi(output)
+                    self.assertIn("xml", plain)
+                    self.assertIn("<think>literal</think>", plain)
+                    self.assertIn("Done", plain)
+                    self.assertNotIn("hidden", plain)
+
+    def test_incomplete_fence_copy_and_final_preserve_trailing_whitespace(self):
+        for ending in ("\t", "  ", "\t  \n\n"):
+            recipe = "all:\n\t@echo hello" + ending
+            source = "```makefile\n" + recipe
+            self.assertEqual(cli._assistant_copy_text(source), source)
+            obj = cli.HermesCLI.__new__(cli.HermesCLI)
+            obj.conversation_history = [{"role": "assistant", "content": source}]
+            with patch("hermes_cli.clipboard.is_remote_shell_session", return_value=False), \
+                 patch("hermes_cli.clipboard.write_clipboard_text", return_value=True) as copy, \
+                 patch.object(cli, "_cprint"):
+                obj._handle_copy_command("/copy")
+            copy.assert_called_once_with(source)
+            for mode in ("strip", "raw", "render"):
+                with patch("hermes_cli.cli_code_blocks.render_code_block", wraps=render_code_block) as render:
+                    cli._render_final_assistant_content(cli._assistant_copy_text(source), mode)
+                self.assertEqual(render.call_args.args[0], CodeBlock(recipe, "makefile"))
+            self.assertEqual(obj.conversation_history[0]["content"], source)
+        self.assertEqual(cli._assistant_copy_text("  ordinary prose  \n\n"), "ordinary prose")
+
+    def test_terminal_controls_cannot_execute_in_code_display(self):
+        payload = ("BEFORE\x1b[2JAFTER\x1b]52;c;evil\x07\x1bPdata\x1b\\"
+                   "\x9b2J\x9dtitle\x9c\x00\x07\x08\x1b\n")
+        source = "```text\n" + payload + "```\nDone"
+        # Capture bytes. Never write an executable payload to a real terminal.
+        outputs = [code_block_ansi(CodeBlock(payload, "text"))]
+        outputs.extend(self.final(source, mode) for mode in ("strip", "raw", "render"))
+        outputs.append(self.resumed(source))
+        outputs.append(self.stream(source)[1])
+        for output in outputs:
+            plain = plain_ansi(output)
+            self.assertNotRegex(plain, r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
+            self.assertIn("BEFOREAFTER", plain)
+        self.assertEqual(cli._assistant_copy_text(source), source)
+
+    def test_partial_prose_preview_without_newline_or_duplicate_output(self):
+        sentence = "A long unfinished sentence " * 8
+        for enabled in (True, False):
+            for chunk in (1, 7, len(sentence)):
+                obj, _, output = self.stream(sentence, chunk, finish=False, enabled=enabled)
+                self.assertTrue(getattr(obj, "_spinner_text", "").startswith("… "))
+                self.assertEqual(obj._stream_buf, sentence)
+                self.assertNotIn(sentence, plain_ansi("\n".join(output)))
+                with patch.object(cli, "_cprint", lambda value: output.append(str(value))):
+                    obj._stream_delta("\n```xml\n<think>literal</think>\n```\n")
+                    obj._flush_stream()
+                plain = plain_ansi("\n".join(output))
+                self.assertEqual(plain.count(sentence.rstrip()), 1)
+                if enabled:
+                    self.assertIn("<think>literal</think>", plain)
+
+    def test_partial_fence_and_code_never_become_prose_preview(self):
+        for prefix in ("```", "  ~~~", "```python\n"):
+            obj, _, _ = self.stream(prefix + "x" * 100, finish=False)
+            self.assertFalse(getattr(obj, "_spinner_text", ""))
+        # Four spaces and inline delimiters cannot start a fence.
+        for prose in ("    ```", "plain ```"):
+            obj, _, _ = self.stream(prose + "x" * 100, finish=False)
+            self.assertTrue(getattr(obj, "_spinner_text", ""))
+
+    def test_unmocked_stream_printer_in_disposable_pty(self):
+        import os
+        import select
+        import subprocess
+        import sys
+        import time
+        if os.name != "posix":
+            self.skipTest("POSIX PTY required")
+        import pty
+
+        source = ("<think>\n```python\nSECRET = 123\n```\nprivate tail</think>"
+                  "```makefile\nall:\n\t@echo hello\n```\nDone")
+        from pathlib import Path
+        repository = str(Path(__file__).resolve().parents[2])
+        script = (f"import sys, types; sys.path.insert(0, {repository!r})\n"
+                  "sys.modules['hermes_bootstrap'] = types.ModuleType('hermes_bootstrap')\n"
+                  "import cli\n"
+                  "cli.CLI_CONFIG.setdefault('display', {})['code_highlighting'] = True\n"
+                  "obj = cli.HermesCLI.__new__(cli.HermesCLI)\n"
+                  "obj.code_highlighting = True\n"
+                  "obj.final_response_markdown = 'strip'\n"
+                  "obj.show_reasoning = False\n"
+                  "obj.show_timestamps = False\n"
+                  "obj._reset_stream_state()\n"
+                  "obj._scrollback_box_width = lambda: 40\n"
+                  f"obj._stream_delta({source!r})\n"
+                  "obj._flush_stream()\n")
+        # A managed base interpreter loads dependencies from a selected venv.
+        # Use that venv directly and stub bootstrap above so the isolated child
+        # cannot trigger dependency installation against pytest's scratch profile.
+        executable = sys.executable
+        if sys.prefix == sys.base_prefix:
+            from pathlib import Path
+            import rich
+            for parent in Path(rich.__file__).parents:
+                if parent.name in ("venv", ".venv"):
+                    executable = str(parent / "bin" / "python")
+                    break
+        master, slave = pty.openpty()
+        child = subprocess.Popen([executable, "-B", "-c", script], stdin=slave,
+                                 stdout=slave, stderr=slave,
+                                 env={**os.environ, "TERM": "xterm-256color",
+                                      "PYTHONDONTWRITEBYTECODE": "1"})
+        os.close(slave)
+        output = b""
+        try:
+            deadline = time.monotonic() + 15
+            while time.monotonic() < deadline:
+                if not select.select([master], [], [], 0.2)[0]:
+                    continue
+                try:
+                    chunk = os.read(master, 65536)
+                except OSError:
+                    break
+                if not chunk:
+                    break
+                output += chunk
+            child.wait(timeout=5)
+        finally:
+            if child.poll() is None:
+                child.kill()
+                child.wait()
+            os.close(master)
+        self.assertEqual(child.returncode, 0, repr(output))
+        ansi = output.decode().replace("\r", "")
+        from tools.ansi_strip import strip_ansi
+        plain = strip_ansi(ansi)
+        self.assertNotIn("SECRET", plain)
+        self.assertNotIn("private tail", plain)
+        self.assertIn("makefile\nall:\n\t@echo hello\n", plain)
+        self.assertEqual(plain.count("@echo hello"), 1)
+        self.assertEqual(plain.count("Done"), 1)
+        self.assertLess(plain.index("@echo hello"), plain.index("Done"))
+        self.assertNotIn("```", plain)
+        self.assertRegex(ansi, r"\x1b\[[0-9;]*38;(?:2|5);")
+        self.assertRegex(ansi, r"\x1b\[[0-9;]*48;(?:2|5);")
+
+    def test_nested_reasoning_stream_matches_final_for_all_chunk_sizes(self):
+        cases = (
+            ("<think>outer\n<reasoning>inner</reasoning>SECRET</think>\nDone", "Done"),
+            ("<THINK>outer<think>inner</think>SECRET</THINK>\nDone", "Done"),
+            ("<think>outer</reasoning>SECRET</think>\nDone", "Done"),
+            ("<think>outer<reasoning>inner</think>SECRET", ""),
+            ("<think><reasoning>inner</reasoning>SECRET</think>```xml\n<think>literal</think>\n```\nDone", "literal"),
+        )
+        for source, visible in cases:
+            for chunk in (1, 2, 7, len(source)):
+                with self.subTest(source=source, chunk=chunk):
+                    obj, output, _ = self.stream(source, chunk)
+                    plain = plain_ansi(output)
+                    self.assertNotIn("SECRET", plain)
+                    self.assertNotIn("inner", plain)
+                    self.assertNotIn("outer", plain)
+                    if visible:
+                        self.assertIn(visible, plain)
+                        self.assertIn(visible, cli._assistant_copy_text(source))
+                    else:
+                        self.assertEqual(cli._assistant_copy_text(source), "")
+                    obj._reset_stream_state()
+                    self.assertEqual(obj._stream_reasoning_stack, [])
+
+    def test_makefile_tabs_preserved_in_ansi_and_supported_copy(self):
+        recipe = "all:\n\t@echo hello\n\t\t@echo **raw**\n"
+        source = "<think>hidden</think>\n```makefile\n" + recipe + "```"
+        self.assertEqual(plain_ansi(code_block_ansi(CodeBlock(recipe, "makefile"))),
+                         "makefile\n" + recipe)
+        obj = cli.HermesCLI.__new__(cli.HermesCLI)
+        obj.conversation_history = [{"role": "assistant", "content": source}]
+        expected = "```makefile\n" + recipe + "```"
+        with patch("hermes_cli.clipboard.is_remote_shell_session", return_value=False), \
+             patch("hermes_cli.clipboard.write_clipboard_text", return_value=True) as copy, \
+             patch.object(cli, "_cprint"):
+            obj._handle_copy_command("/copy")
+        copy.assert_called_once_with(expected)
+        import base64
+        with patch("hermes_cli.clipboard.is_remote_shell_session", return_value=True), \
+             patch.dict("os.environ", {"TMUX": "", "STY": ""}), \
+             patch("hermes_cli.cli_terminal_mixin._write_terminal_sequence") as terminal, \
+             patch.object(cli, "_cprint"):
+            obj._handle_copy_command("/copy 1")
+        terminal.assert_called_once()
+        sequence = terminal.call_args.args[1]
+        self.assertTrue(sequence.startswith("\x1b]52;c;"))
+        self.assertTrue(sequence.endswith("\x07"))
+        self.assertEqual(base64.b64decode(sequence[7:-1]).decode(), expected)
+        self.assertEqual(obj.conversation_history[0]["content"], source)
+        # Rich final panels expand tabs to display cells. Selection is not raw copy.
+        self.assertNotIn("\t", self.final(expected))
+        self.assertIn("        @echo hello", plain_ansi(self.final(expected)))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/hermes_cli/test_cli_modern_layout.py b/tests/hermes_cli/test_cli_modern_layout.py
