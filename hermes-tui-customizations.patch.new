diff --git a/hermes_cli/cli_code_blocks.py b/hermes_cli/cli_code_blocks.py
new file mode 100644
index 0000000000..0bd6d9c884
--- /dev/null
+++ b/hermes_cli/cli_code_blocks.py
@@ -0,0 +1,203 @@
+"""Fenced-code parsing and copy-friendly Rich rendering for the classic CLI.
+
+Only display text is transformed. Buffer each block so multiline lexer state is
+correct, including when a response ends before its closing fence.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from io import StringIO
+import re
+
+from pygments.lexers import get_lexer_by_name
+from pygments.util import ClassNotFound
+from rich.console import Console
+from rich.syntax import Syntax
+from rich.text import Text
+
+_BACKGROUND = "#20242c"
+_OPEN = re.compile(r"^ {0,3}(`{3,}|~{3,})([^\r\n]*)[\r\n]*$")
+
+
+@dataclass(frozen=True)
+class CodeBlock:
+    code: str
+    language: str
+
+
+class FenceParser:
+    """Consume physical lines; fences must occupy a line, not occur inline."""
+
+    def __init__(self):
+        self.fence = ""
+        self.language = ""
+        self.lines: list[str] = []
+
+    @property
+    def in_code(self) -> bool:
+        return bool(self.fence)
+
+    def push(self, line: str) -> tuple[str, str | CodeBlock | None]:
+        if self.in_code:
+            if re.fullmatch(r" {0,3}" + re.escape(self.fence[0]) +
+                            r"{" + str(len(self.fence)) + r",}[ \t]*(?:\r?\n)?", line):
+                return "block", self.finish()
+            self.lines.append(line)
+            return "code", None
+        match = _OPEN.fullmatch(line)
+        if match and not (match[1][0] == "`" and "`" in match[2]):
+            self.fence = match[1]
+            self.language = match[2].strip().split(maxsplit=1)[0] if match[2].strip() else "text"
+            return "open", None
+        return "prose", line
+
+    def finish(self) -> CodeBlock | None:
+        if not self.in_code:
+            return None
+        block = CodeBlock("".join(self.lines), self.language)
+        self.fence, self.language, self.lines = "", "", []
+        return block
+
+
+def split_fenced_code(text: str):
+    """Yield prose strings and CodeBlocks, preserving code bytes and indentation."""
+    parser = FenceParser()
+    prose: list[str] = []
+    for line in text.splitlines(keepends=True):
+        kind, value = parser.push(line)
+        if kind == "prose":
+            prose.append(value)
+        elif kind == "open" and prose:
+            yield "".join(prose)
+            prose = []
+        elif kind == "block":
+            yield value
+    if prose:
+        yield "".join(prose)
+    block = parser.finish()
+    if block is not None:
+        yield block
+
+
+def strip_fenced_reasoning(text: str) -> str:
+    """Suppress reasoning before recognizing visible fences, preserving literal code tags."""
+    from agent.think_scrubber import THINK_TAG_NAMES
+
+    tags = re.compile(r"<(/?)(" + "|".join(re.escape(tag) for tag in THINK_TAG_NAMES) + r")>",
+                      re.IGNORECASE)
+    parser = FenceParser()
+    hidden: list[str] = []
+    parts: list[str] = []
+    for line in text.splitlines(keepends=True):
+        if parser.in_code:
+            parser.push(line)
+            parser.lines.clear()
+            parts.append(line)
+            continue
+        visible: list[str] = []
+        pos = 0
+        while pos < len(line):
+            # Visible fence info is literal too. Recheck after a reasoning closer
+            # exposes an opener on this same physical line.
+            if not hidden and parser.push("".join(visible) + line[pos:])[0] == "open":
+                visible.append(line[pos:])
+                break
+            match = tags.search(line, pos)
+            if match is None:
+                if not hidden:
+                    visible.append(line[pos:])
+                break
+            if not hidden:
+                visible.append(line[pos:match.start()])
+            name = match[2].lower()
+            if not match[1]:
+                hidden.append(name)
+            elif hidden and hidden[-1] == name:
+                hidden.pop()
+            # A mismatched closer cannot end the active reasoning block.
+            pos = match.end()
+        cleaned = "".join(visible)
+        if cleaned:
+            parts.append(cleaned)
+    return "".join(parts)
+
+
+def fence_opening_possible(text: str) -> bool:
+    """Whether an unfinished physical line can still become a valid opening fence."""
+    return re.fullmatch(r" {0,3}(?:`{1,2}|~{1,2}|`{3,}[^`\r\n]*|~{3,}[^\r\n]*)?", text) is not None
+
+
+def render_code_block(block: CodeBlock) -> Text:
+    """Render display-safe code; use /copy for raw tabs rather than terminal selection."""
+    from tools.ansi_strip import sanitize_display_text
+
+    code = sanitize_display_text(block.code)
+    language = sanitize_display_text(block.language)
+    try:
+        lexer = get_lexer_by_name(language, stripnl=False, ensurenl=False)
+    except ClassNotFound:
+        lexer = get_lexer_by_name("text", stripnl=False, ensurenl=False)
+    syntax = Syntax(code, lexer, theme="monokai", background_color=_BACKGROUND,
+                    line_numbers=False, word_wrap=False)
+    result = Text(language + "\n", style=f"on {_BACKGROUND}")
+    result.stylize("bold #aab7c4", 0, len(language))
+    result.append_text(syntax.highlight(code))
+    if not result.plain.endswith("\n"):
+        result.append("\n")
+    return result
+
+
+def map_fenced_prose(text: str, transform) -> str:
+    """Apply display scrubbing outside fences without changing saved/copied code."""
+    parser = FenceParser()
+    parts: list[str] = []
+    prose: list[str] = []
+
+    def flush(before_fence=False):
+        if prose:
+            original = "".join(prose)
+            cleaned = transform(original)
+            if cleaned and before_fence and original.endswith("\n"):
+                cleaned += "\n"
+            parts.append(cleaned)
+            prose.clear()
+
+    for line in text.splitlines(keepends=True):
+        kind, _ = parser.push(line)
+        parser.lines.clear()
+        if kind == "prose":
+            prose.append(line)
+        else:
+            flush(before_fence=True)
+            parts.append(line)
+    flush()
+    return "".join(parts)
+
+
+def code_block_ansi(block: CodeBlock) -> str:
+    """Render once without inserted wraps; the terminal supplies soft wrapping."""
+    rendered = render_code_block(block)
+    output = StringIO()
+    # Never truncate a source line to the current window width.
+    width = max(1, *(Text(line).cell_len for line in rendered.plain.splitlines()))
+    console = Console(file=output, width=width, force_terminal=True, color_system="truecolor")
+    from rich.segment import Segment, Segments
+    # Text.__rich_console__ expands tabs even with soft_wrap=True. Its public
+    # segment renderer preserves them. The emulator may still expand selection
+    # into spaces, so /copy remains the raw-source copy path.
+    segments = []
+    for segment in rendered.render(console):
+        lines = segment.text.split("\n")
+        for index, line in enumerate(lines):
+            if index:
+                segments.append(Segment.line())  # newline after any style reset
+            if line:
+                segments.append(Segment(line, segment.style))
+    console.print(Segments(segments), end="", soft_wrap=True)
+    return output.getvalue()
+
+
+def code_highlighting_enabled() -> bool:
+    """Use the shared config for final/restored rendering, whose callers have no CLI instance."""
+    from cli import CLI_CONFIG
+    return CLI_CONFIG.get("display", {}).get("code_highlighting", False) is True
