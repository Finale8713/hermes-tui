+@pytest.mark.parametrize("task", ["", "voice_chat"])
+def test_included_multiple_calls_remain_known_zero(cost_cli, db, task):
+    for _ in range(2):
+        db.update_token_counts("conversation", model="included-model", task=task,
+                               input_tokens=10, api_call_count=1,
+                               estimated_cost_usd=0, cost_status="included")
+    assert cost_cli._get_status_bar_session_cost() == "Session cost ~$0.0000"
