+    def _status_bar_right_badge_mode(self) -> str:
+        """Cost is opt-in; shared installs keep other profiles' title badges."""
+        from cli import CLI_CONFIG
+        display = CLI_CONFIG.get("display", {}) if isinstance(CLI_CONFIG, dict) else {}
