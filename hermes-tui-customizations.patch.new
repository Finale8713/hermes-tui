+def test_malformed_live_counter_fallback_is_bounded(cost_cli, monkeypatch, counter, width):
+    cost_cli.model = "very-long-model-name-" * 20
+    cost_cli.agent = SimpleNamespace(session_api_calls=counter, session_estimated_cost_usd=0.2,
+                                    session_cost_status="estimated",
+                                    context_compressor=SimpleNamespace(last_prompt_tokens="broken"))
+    monkeypatch.setattr(cost_cli, "_get_tui_terminal_width", lambda: width)
+    for text in (cost_cli._build_status_bar_text(width),
+                 "".join(value for _, value in cost_cli._get_status_bar_fragments())):
+        assert cost_cli._status_bar_display_width(text) <= width
+        if cost_cli._status_title_badge("Session cost unavailable", width, cost=True):
+            assert text.endswith(" Session cost unavailable ")
+
+
+def test_live_multicall_without_coverage_is_unavailable(cost_cli):
