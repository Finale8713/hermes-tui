index 12c7e37cae..8fc7d1b4b7 100644
--- a/hermes_cli/cli_stream_mixin.py
+++ b/hermes_cli/cli_stream_mixin.py
@@ -349,6 +349,58 @@ class CLIStreamMixin:
             self._release_held_status_lines()
 
     def _stream_delta(self, text) -> None:
+        """Recognize fences before the reasoning filter can consume literal code tags."""
+        if not getattr(self, "code_highlighting", False) or text is None:
+            self._filter_stream_delta(text)
+            return
+        from hermes_cli.cli_code_blocks import FenceParser, fence_opening_possible
+        if not hasattr(self, "_code_prefilter"):
+            self._code_prefilter = FenceParser()
+        self._code_prefilter_buf = getattr(self, "_code_prefilter_buf", "") + (text or "")
+        while "\n" in self._code_prefilter_buf:
+            line, self._code_prefilter_buf = self._code_prefilter_buf.split("\n", 1)
+            line += "\n"
+            prose_line = getattr(self, "_code_prefilter_prose", False)
+            self._code_prefilter_prose = False
+            if prose_line or getattr(self, "_in_reasoning_block", False):
+                self._filter_stream_delta(line)
+                self._sync_code_prefilter()
+                continue
+            kind, _ = self._code_prefilter.push(line)
+            self._code_prefilter.lines.clear()  # scanner only; renderer owns the source
+            if kind != "prose":
+                pending = getattr(self, "_stream_prefilt", "")
+                if pending:
+                    self._emit_stream_text(pending)
+                    self._stream_prefilt = ""
+                self._stream_started = True
+                self._emit_stream_text(line)
+                self._stream_last_was_newline = True
+            else:
+                self._filter_stream_delta(line)
+                self._sync_code_prefilter()
+        pending = self._code_prefilter_buf
+        if (pending and not self._code_prefilter.in_code
+                and (getattr(self, "_code_prefilter_prose", False)
+                     or getattr(self, "_in_reasoning_block", False)
+                     or not fence_opening_possible(pending))):
+            # Once this physical line is known to be prose, feed partial deltas
+            # immediately. Keep that decision until its newline, not just until
+            # the next delta, which could itself look like an opening fence.
+            self._code_prefilter_buf = ""
+            self._code_prefilter_prose = True
+            self._filter_stream_delta(pending)
+            self._sync_code_prefilter()
+
+    def _sync_code_prefilter(self) -> None:
+        # A reasoning close tag can precede the opener on the same physical line.
+        # The display parser sees that opener after reasoning was removed.
+        parser = getattr(self, "_stream_code_parser", None)
+        if parser:
+            self._code_prefilter.fence = parser.fence
+            self._code_prefilter.language = parser.language
+
