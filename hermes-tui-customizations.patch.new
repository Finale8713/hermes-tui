+@pytest.mark.parametrize("task", ["", "voice_chat"])
+@pytest.mark.parametrize("last_status,last_estimate", [("estimated", 0.2), ("included", 0)])
+@pytest.mark.parametrize("first_status", ["unknown", "estimated"])
+def test_same_route_missing_cost_survives_later_known_call(
+        cost_cli, db, task, last_status, last_estimate, first_status):
+    for status, estimate in [(first_status, None), (last_status, last_estimate)]:
+        db.update_token_counts("conversation", task=task, model="same-route",
+                               billing_provider="openai", input_tokens=100, api_call_count=1,
+                               estimated_cost_usd=estimate, cost_status=status)
+    assert cost_cli._get_status_bar_session_cost() == "Session cost unavailable"
+    summary = db.get_session("conversation")
+    route = dict(db._read_one("SELECT * FROM session_model_usage WHERE task = ?", (task,)))
+    # Existing consumers still see the latest status; the coverage is independent.
+    assert summary["cost_status"] == route["cost_status"] == last_status
+    assert summary["cost_coverage"] == route["cost_coverage"] == "unknown"
+
+
+@pytest.mark.parametrize("first_estimate", [None, 0, -1, float("nan")])
+def test_auxiliary_missing_cost_survives_later_known_call(cost_cli, db, first_estimate):
+    record(db, estimate=0.1)
+    for estimate in [first_estimate, 0.2]:
+        db.record_auxiliary_usage("conversation", "vision", model="same-route",
+                                  input_tokens=10, estimated_cost_usd=estimate)
+    assert cost_cli._get_status_bar_session_cost() == "Session cost unavailable"
+    row = dict(db._read_one("SELECT * FROM session_model_usage WHERE task = 'vision'"))
+    assert row["summary_included"] == 0
+    assert row["cost_coverage"] == "unknown"
+    assert row["cost_status"] is None
+
+
+@pytest.mark.parametrize("legacy_target", ["sessions", "session_model_usage"])
+def test_historical_coverage_is_not_invented(cost_cli, db, legacy_target):
+    record(db, estimate=0.1)
+    db._execute_write(lambda conn: conn.execute(f"UPDATE {legacy_target} SET cost_coverage = NULL"))
+    record(db, estimate=0.2)
+    assert cost_cli._get_status_bar_session_cost() == "Session cost unavailable"
+    row = db._read_one(f"SELECT cost_coverage FROM {legacy_target}")
+    assert row["cost_coverage"] == "historical"
