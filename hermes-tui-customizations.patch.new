diff --git a/tests/agent/test_missing_usage_accounting.py b/tests/agent/test_missing_usage_accounting.py
new file mode 100644
index 0000000000..4bcb42de23
--- /dev/null
+++ b/tests/agent/test_missing_usage_accounting.py
@@ -0,0 +1,176 @@
+"""Phase 1 regression: a completed provider call without usage must reach
+state.db as an unknown-cost attempt, not silently vanish from accounting."""
+import logging
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture()
+def db(tmp_path):
+    session_db = SessionDB(db_path=tmp_path / "test_state.db")
+    yield session_db
+    session_db.close()
+
+
+class _Compressor:
+    """Minimal compressor surface record_response_usage touches."""
+
+    awaiting_real_usage_after_compression = False
+    threshold_tokens = 0
+    _context_probed = False
+    _verify_compaction_cleared_threshold = False
+
+    def __init__(self):
+        self.updates = []
+        self.usage_less_notes = 0
+
+    def update_from_response(self, usage):
+        self.updates.append(usage)
+
+    def note_usage_less_response(self):
+        self.usage_less_notes += 1
+
+
+def _agent(db, session_id="s-no-usage"):
+    db.create_session(session_id, source="test", model="m1")
+    return SimpleNamespace(
+        context_compressor=_Compressor(),
+        session_api_calls=0,
+        session_prompt_tokens=0,
+        session_completion_tokens=0,
+        session_total_tokens=0,
+        session_input_tokens=0,
+        session_output_tokens=0,
+        session_cache_read_tokens=0,
+        session_cache_write_tokens=0,
+        session_reasoning_tokens=0,
+        session_estimated_cost_usd=0.0,
+        session_cost_status="unknown",
+        session_cost_source="none",
+        model="m1",
+        provider="p1",
+        base_url="https://p1.example/v1",
+        api_key="k",
+        api_mode="chat_completions",
+        _session_db=db,
+        _session_db_created=True,
+        session_id=session_id,
+        verbose_logging=False,
+        quiet_mode=True,
+        log_prefix="",
+    )
+
+
+def _totals(db, session_id):
+    with db._lock:
+        row = db._conn.execute(
+            "SELECT input_tokens, output_tokens, api_call_count, estimated_cost_usd,"
+            " cost_status, cost_coverage FROM sessions WHERE id = ?",
+            (session_id,),
+        ).fetchone()
+    return dict(row) if row is not None else None
+
+
+def test_missing_usage_persists_unknown_call_and_keeps_summary_clean(db, tmp_path, monkeypatch, caplog):
+    """The producer queues a zero-token unknown-cost delta; summary totals stay
+    zero, coverage is unknown, and a later priced call cannot turn the pair
+    into a complete covered total."""
+    from agent import turn_usage
+
+    agent = _agent(db)
+    response = SimpleNamespace(usage=None)
+
+    with caplog.at_level(logging.INFO, logger="agent.turn_usage"):
+        turn_usage.record_response_usage(
+            agent, response, messages=[], api_call_count=1, api_duration=0.2,
+            compression_attempts=0, max_compression_attempts=3)
+
+    assert agent.session_api_calls == 1
+    assert db.flush_token_counts()
+
+    totals = _totals(db, "s-no-usage")
+    assert totals["api_call_count"] == 1
+    assert totals["input_tokens"] == 0 and totals["output_tokens"] == 0
+    assert totals["estimated_cost_usd"] in (0.0, None)
+    assert totals["cost_coverage"] == "unknown"
+
+    # A later priced call on the same route cannot make the pair complete.
+    db.update_token_counts(
+        "s-no-usage", input_tokens=10, output_tokens=2, estimated_cost_usd=0.2,
+        cost_status="estimated", cost_source="provider_models_api",
+        billing_provider="p1", billing_base_url="https://p1.example/v1",
+        model="m1", api_call_count=1)
+
+    totals = _totals(db, "s-no-usage")
+    assert totals["api_call_count"] == 2
+    assert totals["cost_coverage"] == "unknown"
+    with db._lock:
+        route = dict(db._conn.execute(
+            "SELECT api_call_count, cost_coverage, summary_included FROM session_model_usage"
+            " WHERE session_id = 's-no-usage'").fetchone())
+    assert route["api_call_count"] == 2
+    assert route["cost_coverage"] == "unknown"
+    assert route["summary_included"] == 1  # a real main-loop delta, even when unpriced
+
+
+def test_missing_usage_reopen_survives_persistence(tmp_path, monkeypatch):
+    """The unknown attempt survives a close/reopen of the store."""
+    from agent import turn_usage
+
+    db = SessionDB(db_path=tmp_path / "reopen.db")
+    try:
+        agent = _agent(db, "s-reopen")
+        turn_usage.record_response_usage(
+            agent, SimpleNamespace(usage=None), messages=[], api_call_count=1,
+            api_duration=0.1, compression_attempts=0, max_compression_attempts=3)
+        assert db.flush_token_counts()
+    finally:
+        db.close()
+
+    reopened = SessionDB(db_path=tmp_path / "reopen.db")
+    try:
+        totals = _totals(reopened, "s-reopen")
+        assert totals["api_call_count"] == 1
+        assert totals["cost_coverage"] == "unknown"
+    finally:
+        reopened.close()
+
+
+def test_included_zero_usage_is_not_reported_unknown(monkeypatch):
+    """A genuinely included/free response (real usage, zero dollars) must not
+    be misfiled as missing usage."""
+    from agent import turn_usage
+
+    compressor = _Compressor()
+    queue = []
+
+    agent = SimpleNamespace(
+        context_compressor=compressor,
+        session_api_calls=0,
+        session_prompt_tokens=0, session_completion_tokens=0, session_total_tokens=0,
+        session_input_tokens=0, session_output_tokens=0, session_cache_read_tokens=0,
+        session_cache_write_tokens=0, session_reasoning_tokens=0,
+        session_estimated_cost_usd=0.0, session_cost_status="unknown", session_cost_source="none",
+        model="m-free", provider="p1", base_url="", api_key="k", api_mode="chat_completions",
+        _session_db=SimpleNamespace(queue_token_counts=lambda *a, **k: queue.append(k)),
+        _session_db_created=True, session_id="s-free",
+        verbose_logging=False, quiet_mode=True, log_prefix="",
+    )
+    from agent import usage_pricing as pricing
+    from unittest.mock import patch
+
+    usage = {"prompt_tokens": 5, "completion_tokens": 1, "total_tokens": 6}
+    with patch("agent.turn_usage.estimate_usage_cost",
+               return_value=pricing.CostResult(amount_usd=pricing._ZERO, status="included",
+                                               source="none", label="included")):
+        turn_usage.record_response_usage(
+            agent, SimpleNamespace(usage=usage), messages=[], api_call_count=1,
+            api_duration=0.1, compression_attempts=0, max_compression_attempts=3)
+
+    assert agent.session_api_calls == 1
+    assert agent.session_cost_status == "included"
+    assert queue and queue[-1]["cost_status"] == "included"
+    assert queue[-1]["input_tokens"] == 5  # real usage persisted, not an unknown attempt
\ No newline at end of file
diff --git a/tests/agent/test_platform_hint_cli_code.py b/tests/agent/test_platform_hint_cli_code.py
new file mode 100644
index 0000000000..229f806540
--- /dev/null
+++ b/tests/agent/test_platform_hint_cli_code.py
@@ -0,0 +1,58 @@
+"""CLI platform instructions reflect the current profile's code renderer."""
+from types import SimpleNamespace
+from unittest.mock import patch
+import unittest
+
+from agent.prompt_builder import PLATFORM_HINTS
+from agent.system_prompt import platform_hint
+
+
+class CLIPlatformHintTests(unittest.TestCase):
+    def hint(self, config, platform="cli", overrides=None):
+        agent = SimpleNamespace(platform=platform, _platform_hint_overrides=overrides or {})
+        with patch("agent.prompt_builder._config_readonly", return_value=config):
+            return platform_hint(agent)
+
+    def test_enabled_renderer_allows_language_fences_and_keeps_delivery_limits(self):
+        hint = self.hint({"display": {"code_highlighting": True}})
+        self.assertIn("For code snippets, use fenced code blocks with a language tag", hint)
+        self.assertIn("Write prose as plain text.", hint)
+        self.assertIn("MEDIA:/path tags are NOT intercepted", hint)
+        self.assertIn("Cron jobs scheduled from this session are LOCAL-ONLY", hint)
+        self.assertNotIn("Markdown does NOT render", hint)
+
+    def test_missing_disabled_and_malformed_settings_keep_original_hint(self):
+        for config in ({}, {"display": {}}, {"display": {"code_highlighting": False}},
+                       {"display": {"code_highlighting": "true"}}, {"display": None}, None):
+            with self.subTest(config=config):
+                self.assertEqual(self.hint(config), PLATFORM_HINTS["cli"])
+
+    def test_config_read_failure_keeps_plain_terminal_instructions(self):
+        agent = SimpleNamespace(platform="cli", _platform_hint_overrides={})
+        with patch("hermes_cli.config.load_config_readonly", side_effect=OSError("unreadable")):
+            self.assertEqual(platform_hint(agent), PLATFORM_HINTS["cli"])
+
+    def test_other_surfaces_do_not_inherit_cli_code_instructions(self):
+        surfaces = sorted(k for k in PLATFORM_HINTS if k != "cli")
+        for surface in surfaces:
+            with self.subTest(surface=surface), patch.dict("os.environ", {"HERMES_DESKTOP_TERMINAL": "0"}):
+                self.assertEqual(self.hint({"display": {"code_highlighting": True}}, surface),
+                                 PLATFORM_HINTS[surface])
+
+    def test_explicit_profile_override_still_has_precedence(self):
+        config = {"display": {"code_highlighting": True}}
+        self.assertEqual(self.hint(config, overrides={"cli": {"replace": "Custom terminal contract."}}),
+                         "Custom terminal contract.")
+        appended = self.hint(config, overrides={"cli": {"append": "Prefer bash examples."}})
+        self.assertIn("use fenced code blocks with a language tag", appended)
+        self.assertTrue(appended.endswith("\n\nPrefer bash examples."))
+
+    def test_each_profile_read_changes_capability_without_global_mutation(self):
+        enabled = self.hint({"display": {"code_highlighting": True}})
+        disabled = self.hint({"display": {"code_highlighting": False}})
+        self.assertIn("syntax colors", enabled)
+        self.assertEqual(disabled, PLATFORM_HINTS["cli"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/agent/test_usage_pricing_tiers.py b/tests/agent/test_usage_pricing_tiers.py
new file mode 100644
index 0000000000..d9ab6bfd40
--- /dev/null
+++ b/tests/agent/test_usage_pricing_tiers.py
@@ -0,0 +1,157 @@
+"""OpenRouter context-pricing overrides: tiers must reprice the whole request."""
+from decimal import Decimal
+from types import SimpleNamespace
+
+import pytest
+
+from agent.usage_pricing import (
+    CanonicalUsage,
+    estimate_usage_cost,
+    get_pricing_entry,
+    _pricing_entry_from_metadata,
+)
+
+# Cached OpenRouter /models shape for gpt-6.1-sol: base rates plus one
+# context tier starting at min_prompt_tokens=272000 (per-token USD).
+_SOL_PRICING = {
+    "prompt": "0.000002",
+    "completion": "0.00001",
+    "input_cache_read": "0.0000001",
+    "input_cache_write": "0.0000025",
+    "overrides": [
+        {"min_prompt_tokens": 272000, "prompt": "0.000004", "completion": "0.000015",
+         "input_cache_read": "0.0000002", "input_cache_write": "0.000005"},
+    ],
+}
+
+
+@pytest.fixture
+def openrouter_metadata(monkeypatch):
+    from agent import model_metadata
+    monkeypatch.setattr(model_metadata, "fetch_model_metadata", lambda force_refresh=False: {
+        "openai/gpt-6.1-sol": {"pricing": dict(_SOL_PRICING)},
+    })
+
+
+def _sol(uncached, cached=0, writes=0, output=1000):
+    return estimate_usage_cost(
+        "openai/gpt-6.1-sol",
+        CanonicalUsage(input_tokens=uncached, output_tokens=output,
+                       cache_read_tokens=cached, cache_write_tokens=writes),
+        provider="openrouter")
+
+
+def test_above_threshold_whole_request_uses_override_rates(openrouter_metadata):
+    """prompt_tokens 301,000 >= 272,000: every component reprices, including cache."""
+    result = _sol(uncached=300_000, cached=0, writes=0, output=1_000)
+    assert result.amount_usd == (Decimal(300_000) * Decimal("0.000004")
+                                 + Decimal(1_000) * Decimal("0.000015"))
+
+
+def test_below_threshold_uses_base_rates(openrouter_metadata):
+    result = _sol(uncached=271_000, output=1_000)
+    assert result.amount_usd == (Decimal(271_000) * Decimal("0.000002")
+                                 + Decimal(1_000) * Decimal("0.00001"))
+
+
+def test_cache_components_reprice_in_tier(openrouter_metadata):
+    """Crossing the tier via cached tokens also reprices cache reads/writes."""
+    result = _sol(uncached=1000, cached=271_000, writes=500)
+    assert result.amount_usd == (Decimal(1_000) * Decimal("0.000004")
+                                 + Decimal(271_000) * Decimal("0.0000002")
+                                 + Decimal(500) * Decimal("0.000005")
+                                 + Decimal(1_000) * Decimal("0.000015"))
+
+
+def test_tier_threshold_is_inclusive_at_boundary(openrouter_metadata):
+    # prompt_tokens = uncached + cached, output excluded. Exactly 272,000
+    # crosses the tier (inclusive threshold).
+    at = _sol(uncached=271_000, cached=1_000, output=1_000)
+    assert at.amount_usd == (Decimal(271_000) * Decimal("0.000004")
+                             + Decimal(1_000) * Decimal("0.0000002")
+                             + Decimal(1_000) * Decimal("0.000015"))
+    # 271,999 prompt tokens stays on base rates.
+    just_under = _sol(uncached=271_999, output=1_000)
+    assert just_under.amount_usd == (Decimal(271_999) * Decimal("0.000002")
+                                     + Decimal(1_000) * Decimal("0.00001"))
+
+
+def test_highest_applicable_tier_wins():
+    entry = _pricing_entry_from_metadata(
+        {"m": {"pricing": {**_SOL_PRICING, "overrides": [
+            {"min_prompt_tokens": 100_000, "prompt": "0.000003"},
+            {"min_prompt_tokens": 272_000, "prompt": "0.000004"},
+        ]}}}, "m", source_url="u", pricing_version="v")
+    assert entry is not None
+    # The metadata parser keeps the LOWEST threshold as the entry's tier anchor
+    # so every override tier is reachable; per-request selection in
+    # estimate_usage_cost picks the highest applicable override.
+    assert entry.tier_threshold_tokens == 100_000
+    assert entry.input_cost_per_million == Decimal("2")
+
+
+def test_tier_selection_uses_highest_matching_override(monkeypatch):
+    from agent import model_metadata
+    metadata = {"m": {"pricing": {**_SOL_PRICING, "overrides": [
+        {"min_prompt_tokens": 100_000, "prompt": "0.000003", "completion": "0.000012"},
+        {"min_prompt_tokens": 272_000, "prompt": "0.000004", "completion": "0.000015"},
+    ]}}}
+    monkeypatch.setattr(model_metadata, "fetch_model_metadata", lambda force_refresh=False: metadata)
+    result = estimate_usage_cost(
+        "m", CanonicalUsage(input_tokens=300_000, output_tokens=1_000), provider="openrouter")
+    assert result.amount_usd == (Decimal(300_000) * Decimal("0.000004")
+                                 + Decimal(1_000) * Decimal("0.000015"))
+
+
+def test_partial_override_falls_back_to_base_for_missing_fields(monkeypatch):
+    from agent import model_metadata
+    metadata = {"m": {"pricing": {"prompt": "0.000002", "completion": "0.00001",
+                                  "input_cache_read": "0.0000001",
+                                  "overrides": [{"min_prompt_tokens": 200_000, "prompt": "0.000004"}]}}}
+    monkeypatch.setattr(model_metadata, "fetch_model_metadata", lambda force_refresh=False: metadata)
+    # Input reprices; completion keeps the base rate; missing cache-read fields
+    # with zero cache usage must not turn the request unknown.
+    result = estimate_usage_cost(
+        "m", CanonicalUsage(input_tokens=250_000, output_tokens=10), provider="openrouter")
+    assert result.amount_usd == (Decimal(250_000) * Decimal("0.000004")
+                                 + Decimal(10) * Decimal("0.00001"))
+
+
+def test_missing_cache_rate_with_nonzero_cache_use_stays_unknown(monkeypatch):
+    from agent import model_metadata
+    metadata = {"m": {"pricing": {"prompt": "0.000002", "completion": "0.00001",
+                                  "overrides": [{"min_prompt_tokens": 200_000, "prompt": "0.000004"}]}}}
+    monkeypatch.setattr(model_metadata, "fetch_model_metadata", lambda force_refresh=False: metadata)
+    result = estimate_usage_cost(
+        "m", CanonicalUsage(input_tokens=250_000, output_tokens=10, cache_read_tokens=50_000),
+        provider="openrouter")
+    assert result.status == "unknown" and result.amount_usd is None
+
+
+@pytest.mark.parametrize("raw", [
+    {"overrides": [{"min_prompt_tokens": 0, "prompt": "0.000004"}]},           # zero threshold
+    {"overrides": [{"min_prompt_tokens": -5, "prompt": "0.000004"}]},          # negative
+    {"overrides": [{"min_prompt_tokens": "abc", "prompt": "0.000004"}]},       # non-numeric
+    {"overrides": [{"min_prompt_tokens": True, "prompt": "0.000004"}]},        # JSON bool is an int
+    {"overrides": [{"min_prompt_tokens": 100}]},                               # missing rates
+    {"overrides": [{"prompt": "0.000004"}]},                                   # missing threshold
+    {"overrides": "garbage"},                                                  # wrong shape
+])
+def test_malformed_overrides_are_ignored_not_fatal(raw, monkeypatch):
+    from agent import model_metadata
+    metadata = {"m": {"pricing": {"prompt": "0.000002", "completion": "0.00001", **raw}}}
+    monkeypatch.setattr(model_metadata, "fetch_model_metadata", lambda force_refresh=False: metadata)
+    entry = get_pricing_entry("m", provider="openrouter")
+    assert entry is not None
+    assert entry.input_cost_per_million == Decimal("2")
+    assert entry.tier_threshold_tokens is None
+    result = estimate_usage_cost(
+        "m", CanonicalUsage(input_tokens=500_000, output_tokens=0), provider="openrouter")
+    assert result.amount_usd == Decimal("1")  # base rate on the whole 0.5M input
+
+
+def test_base_direct_provider_entry_unaffected_by_openrouter_tiers(openrouter_metadata):
+    """Non-OpenRouter routes keep their own pricing; tiers never leak across routes."""
+    from agent.usage_pricing import resolve_billing_route
+    route = resolve_billing_route("openai/gpt-6.1-sol", provider="openrouter")
+    assert route.provider == "openrouter"
