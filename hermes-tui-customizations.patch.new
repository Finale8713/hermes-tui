+
+    @staticmethod
+    def _status_bar_cost_label(rows: list[dict]) -> str:
+        """Use recorded dollars, never reprice mixed-model tokens at today's model rate.
+
+        cost_coverage tracks missing reports without changing the legacy last-call
+        cost_status. NULL coverage on persisted history is not a complete total.
+        Actual subtotals are exact only for a single accounted call.
+        """
+        total = 0.0
+        exact = True
+        calls = 0
+        for row in rows:
+            try:
+                count = int(row.get("api_call_count") or 0)
+            except (TypeError, ValueError, OverflowError):
+                return "Session cost unavailable"
+            if count < 0:
+                return "Session cost unavailable"
+            status = row.get("cost_status")
+            estimate = row.get("estimated_cost_usd")
+            actual = row.get("actual_cost_usd")
+            has_usage = count or any(row.get(k) for k in (
+                "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens"))
+            if not has_usage and estimate is None and actual is None:
+                continue
+            coverage = row.get("cost_coverage")
+            if "cost_coverage" in row and coverage not in {"complete", "actual_only"}:
+                return "Session cost unavailable"
+            if count != 1 and coverage != "complete":
+                # Resume-local multi-call totals have no persistent coverage evidence.
+                return "Session cost unavailable"
+            if status not in {"actual", "estimated", "included"}:
+                return "Session cost unavailable"
+            # Zero in the model ledger is also the default for missing actual cost.
+            use_actual = status == "actual" and count == 1 and actual is not None
+            amount = actual if use_actual else (0 if status == "included" and estimate is None else estimate)
+            try:
+                amount = float(amount)
+            except (TypeError, ValueError, OverflowError):
+                return "Session cost unavailable"
+            if not math.isfinite(amount) or amount < 0:
+                return "Session cost unavailable"
+            if status == "estimated" and amount == 0:
+                # The persisted schema coalesces a missing estimate to zero. Only an
+                # explicit included/actual result proves a zero-dollar conversation.
+                return "Session cost unavailable"
+            if status == "actual" and not use_actual and amount == 0:
+                return "Session cost unavailable"
+            total += amount
+            if not math.isfinite(total):
+                return "Session cost unavailable"
+            calls += count
+            exact = exact and (use_actual or status == "included" and count == 1 and amount == 0)
+        if not calls and not total:
+            return "Session cost unavailable"
+        from agent.usage_pricing import cost_subprecision_text
+
+        dollars = cost_subprecision_text(total, 4) or f"${total:.4f}"
+        return f"Session cost {'~' if not exact else ''}{dollars}"
+
+    def _get_status_bar_session_cost(self) -> str:
+        """Conversation-only accounting, including persisted resume/compression usage.
+
+        DB reads are TTL-cached, and never query account limits or change saved titles.
+        Live agent totals are a fallback only: they reset on resume/model recreation.
+        """
+        agent = getattr(self, "agent", None)
+        session_id = str(getattr(agent, "session_id", None) or getattr(self, "session_id", "") or "")
+        db = getattr(self, "_session_db", None) or getattr(agent, "_session_db", None)
+        if db is not None and session_id:
+            now = time.monotonic()
+            key = (id(db), session_id)
+            cached = getattr(self, "_status_bar_cost_cache", None)
+            if cached and cached[0] == key and now - cached[1] < 1.5:
+                return cached[2]
+            try:
+                # Do not force the token writer to drain on the UI repaint thread.
+                # The next TTL read sees its committed deltas.
+                chain = db._session_lineage_root_to_tip(session_id)
+                sessions = [dict(r) for r in db._read_all(
+                    f"SELECT * FROM sessions WHERE id IN ({','.join('?' for _ in chain)})", chain)]
+                by_id = {row["id"]: row for row in sessions}
+                ids = [session_id]
+                current = by_id.get(session_id)
+                while current and not db._is_explicit_fork_child_row(current, include_reset=True):
+                    parent = by_id.get(current.get("parent_session_id"))
+                    if not parent or parent.get("end_reason") != "compression" or parent["id"] in ids:
+                        break
+                    ids.append(parent["id"])
+                    current = parent
+                rows = [by_id[sid] for sid in ids if sid in by_id]
+                for row in rows:
+                    row.setdefault("cost_coverage", None)
+                routes = [dict(r) for r in db._read_all(
+                    f"SELECT * FROM session_model_usage WHERE session_id IN ({','.join('?' for _ in ids)})", ids)]
+                # A task name does not mean auxiliary-only: voice_chat already updates
+                # the summary. Persist the writer's ownership instead of adding it twice.
+                aux = [row for row in routes if row.get("summary_included") == 0]
+                for row in aux:
+                    row["cost_status"] = "estimated" if row.get("estimated_cost_usd") else "unknown"
+                if any(row.get("summary_included") is None or
+                       row.get("cost_coverage") not in {"complete", "actual_only"} for row in routes):
+                    label = "Session cost unavailable"
+                else:
+                    label = self._status_bar_cost_label(rows + aux)
+                self._status_bar_cost_cache = (key, now, label)
+                return label
+            except Exception:
+                # A broken persisted read cannot safely fall back to resume-local totals.
+                return "Session cost unavailable"
+        if agent is None:
+            return "Session cost unavailable"
+        return self._status_bar_cost_label([{
+            "api_call_count": getattr(agent, "session_api_calls", 0),
+            "estimated_cost_usd": getattr(agent, "session_estimated_cost_usd", None),
+            "actual_cost_usd": getattr(agent, "session_actual_cost_usd", None),
+            "cost_status": getattr(agent, "session_cost_status", "unknown"),
+            **{k: getattr(agent, f"session_{k}", 0) for k in (
+                "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens")},
+        }])
+
+    def _status_bar_right_badge(self, snapshot: dict, field_set) -> str:
+        if self._status_bar_right_badge_mode() == "cost":
+            return self._get_status_bar_session_cost() if field_set is None or "cost" in field_set else ""
+        return (snapshot.get("session_title") or "") if field_set is None or "title" in field_set else ""
+
